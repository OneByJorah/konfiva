# ─────────────────────────────────────────────────────────────
# konfiva — Example Environment Configuration
# Copy this file to .env and fill in real values before production use.
# Never commit real credentials to git.
# ─────────────────────────────────────────────────────────────

# Server
SERVER_NAME=konfiva.local
SECRET_KEY=<set-value>

# Database
DATABASE_URL=sqlite:///instance/konfiva.db

# FTP (legacy) — disabled by default for safer deployments
FTP_ENABLED=false
FTP_HOST=127.0.0.1
FTP_PORT=21
FTP_USER=konfiva
FTP_PASS=
FTP_SSL=true

# SFTP
SFTP_ENABLED=false
SFTP_HOST=127.0.0.1
SFTP_PORT=22

# TFTP
TFTP_ENABLED=false
TFTP_HOST=127.0.0.1
TFTP_PORT=69
TFTP_ROOT=/var/lib/konfiva/tftp

# Oxidized integration
OXIDIZED_ENABLED=false
OXIDIZED_URL=http://localhost:8080
OXIDIZED_API_KEY=

# Git-backed config history
GIT_ENABLED=true
GIT_REPO=/var/lib/konfiva/configs
GIT_BRANCH=main

# Cloud Sync (requires rclone config)
CLOUD_SYNC=false
RCLONE_CONFIG=/etc/konfiva/rclone.conf

# Notifications
SLACK_WEBHOOK=
TEAMS_WEBHOOK=
DISCORD_WEBHOOK=
EMAIL_ENABLED=false
EMAIL_SERVER=
EMAIL_USER=
EMAIL_PASS=
